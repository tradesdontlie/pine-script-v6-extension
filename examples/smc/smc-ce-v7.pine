// ============================================================================
// SMC Confluence Engine v7.0 [nemesis] — Master Execution & Visual Suite
// Pine Script v6 | indicator() | overlay=true
// Complete SMC Toolkit + 4-Layer MTF + Deterministic Setup Engine + SL/TP/RR
// ============================================================================

//@version=6
indicator(
     title            = "SMC Confluence Engine v7.0 [nemesis]",
     shorttitle       = "SMC-CE v7.0",
     overlay          = true,
     max_bars_back    = 500,
     max_labels_count = 300,
     max_lines_count  = 500,
     max_boxes_count  = 200
 )

// ════════════════════════════════════════════════════════════════════════════
// ░░  INPUTS & CONFIGURATION
// ════════════════════════════════════════════════════════════════════════════

// ── 1. 4-Layer MTF Stack ───────────────────────────────────────────────────
grp_mtf = "🗂 MTF Architecture (4-Layer Stack)"
htf_tf       = input.timeframe("240", "Layer A — HTF Macro TF",       group=grp_mtf)
setup_tf     = input.timeframe("60",  "Layer B — Setup / 1H TF",      group=grp_mtf)
entry_tf     = input.timeframe("15",  "Layer C — Context / 15m TF",   group=grp_mtf)

htf_ema_fast = input.int(9,   "HTF Fast EMA",                  minval=3, group=grp_mtf)
htf_ema_slow = input.int(21,  "HTF Slow EMA",                  minval=5, group=grp_mtf)
htf_swing    = input.int(5,   "HTF Pivot Swing Length",        minval=2, maxval=20, group=grp_mtf)
htf_pd_len   = input.int(50,  "HTF Premium/Discount Lookback", minval=10, maxval=200, group=grp_mtf)
setup_swing  = input.int(5,   "1H Pivot Swing Length",         minval=2, maxval=20, group=grp_mtf)
entry_liq_lb = input.int(15,  "15m Lookback (bars on entry TF)", minval=3, maxval=50, group=grp_mtf)

show_htf_lines = input.bool(true, "Show 4H EMA lines",         group=grp_mtf)
show_4h_zones  = input.bool(true, "Show Premium/Discount zone",group=grp_mtf)

// ── 2. Layer D: 5m SMC Execution ───────────────────────────────────────────
grp_smc = "🟩 Layer D — 5m SMC & Trigger Engine"
smc_swing     = input.int(10,    "Swing Length (BOS/CHoCH)",     minval=3, maxval=50, group=grp_smc)
ch_validity   = input.int(12,    "Trigger Armed Validity (bars)", minval=3, maxval=30, group=grp_smc,
                   tooltip="Number of bars CHoCH/BOS trigger remains armed waiting for retest")
disp_mult     = input.float(0.8, "Displacement Min ATR Mult",    minval=0.4, step=0.1, group=grp_smc)
disp_body_pct = input.float(0.55,"Displacement Min Body %",      minval=0.3, step=0.05, group=grp_smc)
ob_search_len = input.int(5,     "OB Origin Search Lookback",    minval=1, maxval=10, group=grp_smc)
ob_expire     = input.int(40,    "OB Expires (bars)",            minval=5, maxval=300, group=grp_smc)
liq_lookback  = input.int(20,    "Liquidity Swing Lookback",     minval=5, maxval=100, group=grp_smc)
liq_wick_pct  = input.float(0.12,"Sweep Min Wick %",             minval=0.02, step=0.02, group=grp_smc)

show_ob       = input.bool(true, "Show Order Block Boxes",       group=grp_smc)
show_bos      = input.bool(true, "Show BOS/CHoCH Lines",         group=grp_smc)
show_liq      = input.bool(true, "Show Liquidity Sweeps",        group=grp_smc)

// ── 3. Market Structure (HH/HL/LH/LL) ──────────────────────────────────────
grp_ms = "📐 5m Market Structure"
ms_swing      = input.int(10,   "Structure Swing Length",       minval=3, maxval=30, group=grp_ms)
show_ms       = input.bool(true,"Show HH/HL/LH/LL Labels",      group=grp_ms)
show_ms_line  = input.bool(true,"Show Structure ZigZag Lines",   group=grp_ms)

// ── 4. Trendlines ──────────────────────────────────────────────────────────
grp_tl = "📏 Trendlines"
tl_pivot_len  = input.int(10,   "Pivot Length",                 minval=3, maxval=30, group=grp_tl)
show_tl       = input.bool(true,"Show Trendlines",              group=grp_tl)
show_tl_break = input.bool(true,"Show Break/Retest Labels",      group=grp_tl)

// ── 5. Fair Value Gaps ─────────────────────────────────────────────────────
grp_fvg = "🕳 Fair Value Gaps"
show_fvg      = input.bool(true, "Show FVG Boxes",              group=grp_fvg)
fvg_min_pct   = input.float(0.10,"Min Gap Size %",              minval=0.0, step=0.01, group=grp_fvg)
fvg_expire    = input.int(80,    "FVG Expires (bars)",          minval=10, maxval=500, group=grp_fvg)
fvg_bull_col  = input.color(color.new(#00c4ff, 75), "Bullish FVG", group=grp_fvg)
fvg_bear_col  = input.color(color.new(#ff3d3d, 75), "Bearish FVG", group=grp_fvg)

// ── 6. Session Levels ──────────────────────────────────────────────────────
grp_sess = "🕐 Session Levels"
show_pdh_pdl  = input.bool(true, "Show PDH/PDL Lines",          group=grp_sess)
sess_liq_pct  = input.float(0.10,"Level Buffer Zone %",         minval=0.02, step=0.02, group=grp_sess)
asia_sess     = input.session("0000-0800", "Asia Session",       group=grp_sess)
london_sess   = input.session("0800-1600", "London Session",     group=grp_sess)
ny_sess       = input.session("1300-2100", "NY Session",         group=grp_sess)

// ── 7. Volume Profile ──────────────────────────────────────────────────────
grp_vp = "📊 Volume Profile"
vp_bars       = input.int(100,  "VP Lookback (bars)",           minval=20, maxval=500, group=grp_vp)
poc_zone_pct  = input.float(0.2,"POC / VA Zone Proximity %",    minval=0.05, step=0.05, group=grp_vp)
show_vp       = input.bool(true,"Show VP Lines (POC/VAH/VAL)",   group=grp_vp)

// ── 8. Signal Engine & Risk Management ─────────────────────────────────────
grp_sig = "🚀 Signal Engine & Risk/Reward"
min_score     = input.int(70,   "Min Confluence Score (0–100)", minval=50, maxval=95, group=grp_sig,
                   tooltip="70+ = Valid Setup | 80+ = High Quality A-Grade | 90+ = A+ High Conviction")
min_rr        = input.float(1.8,"Min Risk:Reward (TP2/Risk)",   minval=1.2, step=0.1, group=grp_sig)
sig_cooldown  = input.int(8,    "Signal Cooldown (bars)",       minval=1, maxval=30, group=grp_sig)
show_signals  = input.bool(true,"Show Trade Entry/SL/TP Labels",group=grp_sig)
show_score    = input.bool(true,"Show Confluence Score",        group=grp_sig)

// ── 9. Visuals & Dashboard ─────────────────────────────────────────────────
grp_vis = "🎨 Visuals"
bull_col      = input.color(#00c4ff, "Bullish Color",           group=grp_vis)
bear_col      = input.color(#ff3d3d, "Bearish Color",           group=grp_vis)
show_dash     = input.bool(true,     "Show Live Dashboard Table", group=grp_vis)
show_st       = input.bool(true,     "Show Supertrend Overlay",   group=grp_vis)

// ════════════════════════════════════════════════════════════════════════════
// ░░  BASE CALCULATIONS
// ════════════════════════════════════════════════════════════════════════════
atr14      = ta.atr(14)
vol_sma    = ta.sma(volume, 20)
is_new_day = ta.change(time("D")) != 0

// ════════════════════════════════════════════════════════════════════════════
// ░░  LAYER A — 4H MACRO BIAS (Non-Repainting Confirmed Security Call)
// ════════════════════════════════════════════════════════════════════════════
[htf_ema_f, htf_ema_s, htf_close, htf_high50, htf_low50, htf_ph, htf_pl] = request.security(
     syminfo.tickerid, htf_tf,
     [ta.ema(close, htf_ema_fast)[1],
      ta.ema(close, htf_ema_slow)[1],
      close[1],
      ta.highest(high, htf_pd_len)[1],
      ta.lowest(low, htf_pd_len)[1],
      ta.pivothigh(high, htf_swing, htf_swing)[1],
      ta.pivotlow(low, htf_swing, htf_swing)[1]],
     lookahead = barmerge.lookahead_on)

var float htf_last_ph = na
var float htf_last_pl = na

if not na(htf_ph)
    htf_last_ph := htf_ph
if not na(htf_pl)
    htf_last_pl := htf_pl

htf_ema_bull = htf_ema_f > htf_ema_s
htf_ema_bear = htf_ema_f < htf_ema_s
htf_bos_bull = not na(htf_last_ph) and htf_close > htf_last_ph
htf_bos_bear = not na(htf_last_pl) and htf_close < htf_last_pl

var int htf_bias = 0
htf_ema_cross_up   = ta.crossover(htf_ema_f, htf_ema_s)
htf_ema_cross_down = ta.crossunder(htf_ema_f, htf_ema_s)

if (htf_ema_cross_down and htf_bias == 1) or (htf_ema_cross_up and htf_bias == -1)
    htf_bias := 0

if htf_ema_bull and htf_bos_bull
    htf_bias := 1
else if htf_ema_bear and htf_bos_bear
    htf_bias := -1

htf_range_mid = (htf_high50 + htf_low50) / 2.0
in_discount   = close < htf_range_mid
in_premium    = close > htf_range_mid

var line  htf_ema_f_line = na
var line  htf_ema_s_line = na
var label htf_ema_f_lbl  = na
var label htf_ema_s_lbl  = na

if show_htf_lines and barstate.islast
    line.delete(htf_ema_f_line)
    line.delete(htf_ema_s_line)
    label.delete(htf_ema_f_lbl)
    label.delete(htf_ema_s_lbl)
    htf_ema_f_line := line.new(bar_index - 5, htf_ema_f, bar_index + 20, htf_ema_f, color=color.new(bull_col, 30), width=1, style=line.style_dashed, extend=extend.right)
    htf_ema_s_line := line.new(bar_index - 5, htf_ema_s, bar_index + 20, htf_ema_s, color=color.new(bear_col, 30), width=1, style=line.style_dashed, extend=extend.right)
    htf_ema_f_lbl  := label.new(bar_index + 20, htf_ema_f, "4H EMA" + str.tostring(htf_ema_fast), style=label.style_label_left, color=color(na), textcolor=color.new(bull_col, 0), size=size.tiny)
    htf_ema_s_lbl  := label.new(bar_index + 20, htf_ema_s, "4H EMA" + str.tostring(htf_ema_slow), style=label.style_label_left, color=color(na), textcolor=color.new(bear_col, 0), size=size.tiny)

var box   pd_prem_box = na
var box   pd_disc_box = na
var label pd_prem_lbl = na
var label pd_disc_lbl = na

if show_4h_zones and not na(htf_high50) and not na(htf_low50) and barstate.islast
    box.delete(pd_prem_box)
    box.delete(pd_disc_box)
    label.delete(pd_prem_lbl)
    label.delete(pd_disc_lbl)
    _left = bar_index - htf_pd_len
    pd_prem_box := box.new(_left, htf_high50, bar_index + 10, htf_range_mid, bgcolor=color.new(bear_col, 92), border_color=color(na))
    pd_disc_box := box.new(_left, htf_range_mid, bar_index + 10, htf_low50, bgcolor=color.new(bull_col, 92), border_color=color(na))
    pd_prem_lbl := label.new(_left, htf_high50, "Premium", style=label.style_label_right, color=color(na), textcolor=color.new(bear_col, 0), size=size.tiny)
    pd_disc_lbl := label.new(_left, htf_low50, "Discount", style=label.style_label_right, color=color(na), textcolor=color.new(bull_col, 0), size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
// ░░  LAYER B — 1H DIRECTIONAL STRUCTURE (Non-Repainting Confirmed Call)
// ════════════════════════════════════════════════════════════════════════════
[h1_ema_f, h1_ema_s, h1_close, h1_ph, h1_pl] = request.security(
     syminfo.tickerid, setup_tf,
     [ta.ema(close, htf_ema_fast)[1],
      ta.ema(close, htf_ema_slow)[1],
      close[1],
      ta.pivothigh(high, setup_swing, setup_swing)[1],
      ta.pivotlow(low, setup_swing, setup_swing)[1]],
     lookahead = barmerge.lookahead_on)

var float h1_last_ph  = na
var float h1_last_pl  = na
var int   h1_bias     = 0

if not na(h1_ph)
    h1_last_ph := h1_ph
if not na(h1_pl)
    h1_last_pl := h1_pl

h1_bos_bull   = not na(h1_last_ph) and h1_close > h1_last_ph and h1_ema_f > h1_ema_s
h1_bos_bear   = not na(h1_last_pl) and h1_close < h1_last_pl and h1_ema_f < h1_ema_s
h1_choch_bull = not na(h1_last_ph) and h1_close > h1_last_ph and h1_bias == -1
h1_choch_bear = not na(h1_last_pl) and h1_close < h1_last_pl and h1_bias ==  1

if h1_bos_bull or h1_choch_bull
    h1_bias := 1
if h1_bos_bear or h1_choch_bear
    h1_bias := -1

h1_ema_trend = h1_ema_f > h1_ema_s ? 1 : h1_ema_f < h1_ema_s ? -1 : 0

// ════════════════════════════════════════════════════════════════════════════
// ░░  LAYER C — 15m CONTEXT & LOCATION (Non-Repainting Confirmed Call)
// ════════════════════════════════════════════════════════════════════════════
[m15_open, m15_high, m15_low, m15_close, m15_swing_hi, m15_swing_lo, prior_m15_open, prior_m15_high, prior_m15_low, prior_m15_close, prior_m15_swing_hi, prior_m15_swing_lo] = request.security(
     syminfo.tickerid, entry_tf,
     [open[1], high[1], low[1], close[1], ta.highest(high, entry_liq_lb)[1], ta.lowest(low, entry_liq_lb)[1],
      open[2], high[2], low[2], close[2], ta.highest(high, entry_liq_lb)[2], ta.lowest(low, entry_liq_lb)[2]],
     lookahead = barmerge.lookahead_on)

m15_breakout_long  = m15_close > prior_m15_swing_hi
m15_breakout_short = m15_close < prior_m15_swing_lo
m15_ssl_sweep      = m15_low < prior_m15_swing_lo and m15_close > prior_m15_swing_lo
m15_bsl_sweep      = m15_high > prior_m15_swing_hi and m15_close < prior_m15_swing_hi

// ════════════════════════════════════════════════════════════════════════════
// ░░  LAYER D — 5m STRUCTURE, DISPLACEMENT & TRIGGER LIFECYCLE
// ════════════════════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, smc_swing, smc_swing)
pl = ta.pivotlow(low,   smc_swing, smc_swing)

var float last_ph     = na
var float last_pl     = na
var int   last_ph_bar = -999
var int   last_pl_bar = -999
var int   ph_age      = 0
var int   pl_age      = 0

ph_age := ph_age + 1
pl_age := pl_age + 1

if not na(ph)
    last_ph     := ph
    last_ph_bar := bar_index - smc_swing
    ph_age      := 0
if not na(pl)
    last_pl     := pl
    last_pl_bar := bar_index - smc_swing
    pl_age      := 0

ph_valid = not na(last_ph) and ph_age <= ob_expire
pl_valid = not na(last_pl) and pl_age <= ob_expire

var int structure_bias = 0

// Measurable Displacement (No Subjectivity)
candle_range = math.max(high - low, syminfo.mintick)
is_disp_bull = (close - open) >= (atr14 * disp_mult) and (close - open) / candle_range >= disp_body_pct
is_disp_bear = (open - close) >= (atr14 * disp_mult) and (open - close) / candle_range >= disp_body_pct

bos_bull   = ph_valid and close > last_ph and close[1] <= last_ph and is_disp_bull
bos_bear   = pl_valid and close < last_pl and close[1] >= last_pl and is_disp_bear
choch_bull = bos_bull and structure_bias <= 0
choch_bear = bos_bear and structure_bias >= 0

if bos_bull or choch_bull
    structure_bias := 1
if bos_bear or choch_bear
    structure_bias := -1

// Trigger Lifecycle: Armed State with expiration
var bool  armed_long              = false
var bool  armed_short             = false
var int   armed_long_bar          = -999
var int   armed_short_bar         = -999
var float armed_long_trigger_lvl  = na
var float armed_short_trigger_lvl = na

if bos_bull or choch_bull
    armed_long              := true
    armed_short             := false
    armed_long_bar          := bar_index
    armed_long_trigger_lvl  := last_ph

if bos_bear or choch_bear
    armed_short             := true
    armed_long              := false
    armed_short_bar         := bar_index
    armed_short_trigger_lvl := last_pl

if armed_long and (bar_index - armed_long_bar) > ch_validity
    armed_long := false
if armed_short and (bar_index - armed_short_bar) > ch_validity
    armed_short := false

// Visual Structure Lines & Labels
var int last_bos_bull_lbl = -999
var int last_bos_bear_lbl = -999
int bos_gap = math.max(3, smc_swing)

if show_bos
    if choch_bull
        _b = math.max(last_ph_bar, bar_index - 100)
        line.new(_b, last_ph, bar_index, last_ph, color=color.new(bull_col, 0), width=1, style=line.style_solid)
        label.new(math.round((_b + bar_index) / 2), last_ph, "CHoCH", style=label.style_none, textcolor=color.new(bull_col, 0), size=size.small, yloc=yloc.price)
        last_bos_bull_lbl := bar_index
    if choch_bear
        _b = math.max(last_pl_bar, bar_index - 100)
        line.new(_b, last_pl, bar_index, last_pl, color=color.new(bear_col, 0), width=1, style=line.style_solid)
        label.new(math.round((_b + bar_index) / 2), last_pl, "CHoCH", style=label.style_none, textcolor=color.new(bear_col, 0), size=size.small, yloc=yloc.price)
        last_bos_bear_lbl := bar_index
    if bos_bull and not choch_bull and (bar_index - last_bos_bull_lbl) >= bos_gap
        _b = math.max(last_ph_bar, bar_index - 100)
        line.new(_b, last_ph, bar_index, last_ph, color=color.new(bull_col, 50), width=1, style=line.style_dashed)
        label.new(math.round((_b + bar_index) / 2), last_ph, "BOS", style=label.style_none, textcolor=color.new(bull_col, 20), size=size.small, yloc=yloc.price)
        last_bos_bull_lbl := bar_index
    if bos_bear and not choch_bear and (bar_index - last_bos_bear_lbl) >= bos_gap
        _b = math.max(last_pl_bar, bar_index - 100)
        line.new(_b, last_pl, bar_index, last_pl, color=color.new(bear_col, 50), width=1, style=line.style_dashed)
        label.new(math.round((_b + bar_index) / 2), last_pl, "BOS", style=label.style_none, textcolor=color.new(bear_col, 20), size=size.small, yloc=yloc.price)
        last_bos_bear_lbl := bar_index

// ════════════════════════════════════════════════════════════════════════════
// ░░  ORDER BLOCKS (Origin Candle Search & ATR Mitigation)
// ════════════════════════════════════════════════════════════════════════════
var float bull_ob_hi  = na
var float bull_ob_lo  = na
var int   bull_ob_bar = -999
var float bear_ob_hi  = na
var float bear_ob_lo  = na
var int   bear_ob_bar = -999

if bos_bull or choch_bull
    int ob_idx = 1
    for k = 1 to ob_search_len
        if close[k] < open[k]
            ob_idx := k
            break
    bull_ob_hi  := high[ob_idx]
    bull_ob_lo  := low[ob_idx]
    bull_ob_bar := bar_index - ob_idx

if bos_bear or choch_bear
    int ob_idx = 1
    for k = 1 to ob_search_len
        if close[k] > open[k]
            ob_idx := k
            break
    bear_ob_hi  := high[ob_idx]
    bear_ob_lo  := low[ob_idx]
    bear_ob_bar := bar_index - ob_idx

// Structural Invalidation with ATR Buffer
bull_ob_valid = not na(bull_ob_hi) and (bar_index - bull_ob_bar) <= ob_expire and close >= (bull_ob_lo - atr14 * 0.25)
bear_ob_valid = not na(bear_ob_hi) and (bar_index - bear_ob_bar) <= ob_expire and close <= (bear_ob_hi + atr14 * 0.25)

in_bull_ob = bull_ob_valid and low  <= (bull_ob_hi + atr14 * 0.1) and high >= bull_ob_lo
in_bear_ob = bear_ob_valid and high >= (bear_ob_lo - atr14 * 0.1) and low  <= bear_ob_hi

var box   bull_ob_box  = na
var box   bear_ob_box  = na
var label bull_ob_lbl  = na
var label bear_ob_lbl  = na
var bool  bull_ob_prev = false
var bool  bear_ob_prev = false

if show_ob
    if bull_ob_valid and not na(bull_ob_hi)
        box.delete(bull_ob_box)
        label.delete(bull_ob_lbl)
        bull_ob_box := box.new(bull_ob_bar, bull_ob_hi, bar_index + 3, bull_ob_lo, border_color=color(na), bgcolor=color.new(bull_col, 85))
        bull_ob_lbl := label.new(bull_ob_bar, bull_ob_hi, "OB", style=label.style_label_right, color=color(na), textcolor=color.new(bull_col, 0), size=size.tiny)
    else
        box.delete(bull_ob_box)
        label.delete(bull_ob_lbl)
        if bull_ob_prev
            label.new(bar_index, close, "OB mitigated", style=label.style_none, textcolor=color.new(bull_col, 20), size=size.tiny)
    bull_ob_prev := bull_ob_valid

    if bear_ob_valid and not na(bear_ob_hi)
        box.delete(bear_ob_box)
        label.delete(bear_ob_lbl)
        bear_ob_box := box.new(bear_ob_bar, bear_ob_hi, bar_index + 3, bear_ob_lo, border_color=color(na), bgcolor=color.new(bear_col, 85))
        bear_ob_lbl := label.new(bear_ob_bar, bear_ob_hi, "OB", style=label.style_label_right, color=color(na), textcolor=color.new(bear_col, 0), size=size.tiny)
    else
        box.delete(bear_ob_box)
        label.delete(bear_ob_lbl)
        if bear_ob_prev
            label.new(bar_index, close, "OB mitigated", style=label.style_none, textcolor=color.new(bear_col, 20), size=size.tiny)
    bear_ob_prev := bear_ob_valid

// ════════════════════════════════════════════════════════════════════════════
// ░░  FAIR VALUE GAPS (Visuals & Active Participation)
// ════════════════════════════════════════════════════════════════════════════
var array<box>   fvg_boxes  = array.new<box>()
var array<label> fvg_labels = array.new<label>()
var array<float> fvg_top    = array.new<float>()
var array<float> fvg_bot    = array.new<float>()
var array<int>   fvg_bias   = array.new<int>()
var array<int>   fvg_bar    = array.new<int>()

fvg_bull_gap = low  > high[2] and (low  - high[2]) / high[2] * 100 >= fvg_min_pct
fvg_bear_gap = high < low[2]  and (low[2] - high) / low[2]  * 100 >= fvg_min_pct

if show_fvg
    if array.size(fvg_boxes) > 0
        for i = array.size(fvg_boxes) - 1 to 0
            _bias     = array.get(fvg_bias, i)
            _bot      = array.get(fvg_bot, i)
            _top      = array.get(fvg_top, i)
            _bar      = array.get(fvg_bar, i)
            mitigated = _bias == 1 ? low <= _bot : high >= _top
            expired   = (bar_index - _bar) > fvg_expire
            if mitigated or expired
                box.delete(array.get(fvg_boxes, i))
                label.delete(array.get(fvg_labels, i))
                if mitigated
                    label.new(bar_index, _bias == 1 ? _bot : _top, "FVG filled", style=label.style_none, textcolor=color.new(_bias == 1 ? fvg_bull_col : fvg_bear_col, 0), size=size.tiny)
                array.remove(fvg_boxes, i)
                array.remove(fvg_labels, i)
                array.remove(fvg_top, i)
                array.remove(fvg_bot, i)
                array.remove(fvg_bias, i)
                array.remove(fvg_bar, i)

    if fvg_bull_gap
        array.push(fvg_top, low)
        array.push(fvg_bot, high[2])
        array.push(fvg_bias, 1)
        array.push(fvg_bar, bar_index)
        array.push(fvg_boxes, box.new(bar_index - 2, low, bar_index, high[2], border_color=color(na), bgcolor=fvg_bull_col, extend=extend.right))
        array.push(fvg_labels, label.new(bar_index - 2, low, "FVG", style=label.style_label_right, color=color(na), textcolor=color.new(fvg_bull_col, 0), size=size.tiny))

    if fvg_bear_gap
        array.push(fvg_top, low[2])
        array.push(fvg_bot, high)
        array.push(fvg_bias, -1)
        array.push(fvg_bar, bar_index)
        array.push(fvg_boxes, box.new(bar_index - 2, low[2], bar_index, high, border_color=color(na), bgcolor=fvg_bear_col, extend=extend.right))
        array.push(fvg_labels, label.new(bar_index - 2, high, "FVG", style=label.style_label_right, color=color(na), textcolor=color.new(fvg_bear_col, 0), size=size.tiny))

    if array.size(fvg_boxes) > 15
        box.delete(array.shift(fvg_boxes))
        label.delete(array.shift(fvg_labels))
        array.shift(fvg_top)
        array.shift(fvg_bot)
        array.shift(fvg_bias)
        array.shift(fvg_bar)

// Active FVG Retest Check
bool in_bull_fvg = false
bool in_bear_fvg = false
if array.size(fvg_boxes) > 0
    for i = 0 to array.size(fvg_boxes) - 1
        _b  = array.get(fvg_bias, i)
        _t  = array.get(fvg_top, i)
        _bt = array.get(fvg_bot, i)
        if _b == 1 and low <= _t and high >= _bt
            in_bull_fvg := true
        if _b == -1 and high >= _bt and low <= _t
            in_bear_fvg := true

// ════════════════════════════════════════════════════════════════════════════
// ░░  5m MARKET STRUCTURE (HH, HL, LH, LL & ZigZag Lines)
// ════════════════════════════════════════════════════════════════════════════
ms_ph = ta.pivothigh(high, ms_swing, ms_swing)
ms_pl = ta.pivotlow(low,   ms_swing, ms_swing)

var float prev_ms_ph = na
var float prev_ms_pl = na

ms_hh = not na(ms_ph) and not na(prev_ms_ph) and ms_ph > prev_ms_ph
ms_lh = not na(ms_ph) and not na(prev_ms_ph) and ms_ph < prev_ms_ph
ms_hl = not na(ms_pl) and not na(prev_ms_pl) and ms_pl > prev_ms_pl
ms_ll = not na(ms_pl) and not na(prev_ms_pl) and ms_pl < prev_ms_pl

var float last_ms_ph_val = na
var float last_ms_pl_val = na

if not na(ms_ph)
    prev_ms_ph     := last_ms_ph_val
    last_ms_ph_val := ms_ph
if not na(ms_pl)
    prev_ms_pl     := last_ms_pl_val
    last_ms_pl_val := ms_pl

var int last_ms_lbl = -999
int ms_gap = math.max(3, ms_swing)

if show_ms and (bar_index - ms_swing - last_ms_lbl) >= ms_gap
    if ms_hh
        label.new(bar_index - ms_swing, ms_ph, "HH", style=label.style_none, textcolor=color.new(bull_col, 20), size=size.small, yloc=yloc.abovebar)
        last_ms_lbl := bar_index - ms_swing
    if ms_lh
        label.new(bar_index - ms_swing, ms_ph, "LH", style=label.style_none, textcolor=color.new(bear_col, 20), size=size.small, yloc=yloc.abovebar)
        last_ms_lbl := bar_index - ms_swing
    if ms_hl
        label.new(bar_index - ms_swing, ms_pl, "HL", style=label.style_none, textcolor=color.new(bull_col, 20), size=size.small, yloc=yloc.belowbar)
        last_ms_lbl := bar_index - ms_swing
    if ms_ll
        label.new(bar_index - ms_swing, ms_pl, "LL", style=label.style_none, textcolor=color.new(bear_col, 20), size=size.small, yloc=yloc.belowbar)
        last_ms_lbl := bar_index - ms_swing

var line ms_ph_line = na
var line ms_pl_line = na

if show_ms_line
    if not na(ms_ph)
        line.delete(ms_ph_line)
        ms_ph_line := line.new(bar_index - ms_swing - ms_swing, nz(prev_ms_ph, ms_ph), bar_index - ms_swing, ms_ph, color=color.new(bear_col, 50), width=1, style=line.style_dashed)
    if not na(ms_pl)
        line.delete(ms_pl_line)
        ms_pl_line := line.new(bar_index - ms_swing - ms_swing, nz(prev_ms_pl, ms_pl), bar_index - ms_swing, ms_pl, color=color.new(bull_col, 50), width=1, style=line.style_dashed)

// ════════════════════════════════════════════════════════════════════════════
// ░░  TRENDLINES (Drawing, Breaks & ATR Retests)
// ════════════════════════════════════════════════════════════════════════════
tl_ph = ta.pivothigh(high, tl_pivot_len, tl_pivot_len)
tl_pl = ta.pivotlow(low,   tl_pivot_len, tl_pivot_len)

var float tl_ph1     = na
var int   tl_ph1_bar = -999
var float tl_ph2     = na
var int   tl_ph2_bar = -999
var float tl_pl1     = na
var int   tl_pl1_bar = -999
var float tl_pl2     = na
var int   tl_pl2_bar = -999

if not na(tl_ph)
    tl_ph2     := tl_ph1
    tl_ph2_bar := tl_ph1_bar
    tl_ph1     := tl_ph
    tl_ph1_bar := bar_index - tl_pivot_len
if not na(tl_pl)
    tl_pl2     := tl_pl1
    tl_pl2_bar := tl_pl1_bar
    tl_pl1     := tl_pl
    tl_pl1_bar := bar_index - tl_pivot_len

tl_bear_slope = not na(tl_ph1) and not na(tl_ph2) and tl_ph1_bar != tl_ph2_bar and tl_ph1_bar != -999 and tl_ph2_bar != -999 ? (tl_ph1 - tl_ph2) / (tl_ph1_bar - tl_ph2_bar) : na
tl_bull_slope = not na(tl_pl1) and not na(tl_pl2) and tl_pl1_bar != tl_pl2_bar and tl_pl1_bar != -999 and tl_pl2_bar != -999 ? (tl_pl1 - tl_pl2) / (tl_pl1_bar - tl_pl2_bar) : na
tl_bear_val   = not na(tl_bear_slope) ? tl_ph1 + tl_bear_slope * (bar_index - tl_ph1_bar) : na
tl_bull_val   = not na(tl_bull_slope) ? tl_pl1 + tl_bull_slope * (bar_index - tl_pl1_bar) : na

tl_bear_break = not na(tl_bear_val) and close > tl_bear_val and close[1] <= tl_bear_val[1]
tl_bull_break = not na(tl_bull_val) and close < tl_bull_val and close[1] >= tl_bull_val[1]

var bool tl_bear_broken    = false
var bool tl_bull_broken    = false
var bool tl_bear_retested  = false
var bool tl_bull_retested  = false
var int  tl_bear_break_bar = -999
var int  tl_bull_break_bar = -999

if not na(tl_ph)
    tl_bear_broken    := false
    tl_bear_retested  := false
    tl_bear_break_bar := -999
if not na(tl_pl)
    tl_bull_broken    := false
    tl_bull_retested  := false
    tl_bull_break_bar := -999

if tl_bear_break
    tl_bear_broken    := true
    tl_bear_retested  := false
    tl_bear_break_bar := bar_index
if tl_bull_break
    tl_bull_broken    := true
    tl_bull_retested  := false
    tl_bull_break_bar := bar_index

tl_retest_dist = atr14 * 0.5
tl_bear_retest = tl_bear_broken and not tl_bear_retested and not na(tl_bear_val) and (bar_index - tl_bear_break_bar) > 1 and math.abs(close - tl_bear_val) <= tl_retest_dist and close > tl_bear_val
tl_bull_retest = tl_bull_broken and not tl_bull_retested and not na(tl_bull_val) and (bar_index - tl_bull_break_bar) > 1 and math.abs(close - tl_bull_val) <= tl_retest_dist and close < tl_bull_val

if tl_bear_retest
    tl_bear_retested := true
if tl_bull_retest
    tl_bull_retested := true

var line tl_bear_line = na
var line tl_bull_line = na

if show_tl
    if not na(tl_ph1) and not na(tl_ph2)
        line.delete(tl_bear_line)
        tl_bear_line := line.new(tl_ph2_bar, tl_ph2, bar_index, tl_bear_val, color=color.new(bear_col, 30), width=1, style=tl_bear_broken ? line.style_dashed : line.style_solid, extend=extend.right)
    if not na(tl_pl1) and not na(tl_pl2)
        line.delete(tl_bull_line)
        tl_bull_line := line.new(tl_pl2_bar, tl_pl2, bar_index, tl_bull_val, color=color.new(bull_col, 30), width=1, style=tl_bull_broken ? line.style_dashed : line.style_solid, extend=extend.right)

if show_tl_break
    if tl_bear_break
        label.new(bar_index, tl_bear_val, "◆  Break", style=label.style_none, textcolor=color.new(bull_col, 0), size=size.small, yloc=yloc.belowbar)
    if tl_bull_break
        label.new(bar_index, tl_bull_val, "◆  Break", style=label.style_none, textcolor=color.new(bear_col, 0), size=size.small, yloc=yloc.abovebar)
    if tl_bear_retest
        label.new(bar_index, tl_bear_val, "●  Retest", style=label.style_none, textcolor=color.new(bull_col, 0), size=size.small, yloc=yloc.belowbar)
    if tl_bull_retest
        label.new(bar_index, tl_bull_val, "●  Retest", style=label.style_none, textcolor=color.new(bear_col, 0), size=size.small, yloc=yloc.abovebar)

// ════════════════════════════════════════════════════════════════════════════
// ░░  LIQUIDITY SWEEPS & SESSION LEVELS
// ════════════════════════════════════════════════════════════════════════════
bsl_level = ta.highest(high, liq_lookback)
ssl_level = ta.lowest(low,   liq_lookback)

liq_sweep_bull = low  < ssl_level[1] - ssl_level[1] * (liq_wick_pct / 100) and close > ssl_level[1]
liq_sweep_bear = high > bsl_level[1] + bsl_level[1] * (liq_wick_pct / 100) and close < bsl_level[1]

var int last_ssl_sw = -999
var int last_bsl_sw = -999
var int last_liq_bull_lbl = -999
var int last_liq_bear_lbl = -999
int liq_gap = math.max(3, smc_swing)

if liq_sweep_bull or m15_ssl_sweep
    last_ssl_sw := bar_index
if liq_sweep_bear or m15_bsl_sweep
    last_bsl_sw := bar_index

recent_ssl_sweep = (bar_index - last_ssl_sw) <= smc_swing * 3
recent_bsl_sweep = (bar_index - last_bsl_sw) <= smc_swing * 3

if show_liq and liq_sweep_bull and (bar_index - last_liq_bull_lbl) >= liq_gap
    label.new(bar_index, low, "•", style=label.style_none, textcolor=color.new(color.purple, 0), size=size.normal)
    label.new(bar_index, low - atr14 * 0.3, "Sell-side", style=label.style_none, textcolor=color.new(color.purple, 30), size=size.small)
    last_liq_bull_lbl := bar_index

if show_liq and liq_sweep_bear and (bar_index - last_liq_bear_lbl) >= liq_gap
    label.new(bar_index, high, "•", style=label.style_none, textcolor=color.new(color.orange, 0), size=size.normal)
    label.new(bar_index, high + atr14 * 0.3, "Buy-side", style=label.style_none, textcolor=color.new(color.orange, 30), size=size.small)
    last_liq_bear_lbl := bar_index

// Sessions (Asia, London, NY)
var float day_high = high
var float day_low  = low
var float pdh      = na
var float pdl      = na

if is_new_day
    pdh      := day_high
    pdl      := day_low
    day_high := high
    day_low  := low
else
    day_high := math.max(day_high, high)
    day_low  := math.min(day_low, low)

in_asia   = not na(time(timeframe.period, asia_sess))
in_london = not na(time(timeframe.period, london_sess))
in_ny     = not na(time(timeframe.period, ny_sess))

var float asia_hi    = na
var float asia_lo    = na
var float london_hi  = na
var float london_lo  = na
var float ny_hi      = na
var float ny_lo      = na
var bool  was_asia   = false
var bool  was_london = false
var bool  was_ny     = false

if in_asia
    asia_hi  := na(asia_hi) or not was_asia ? high : math.max(asia_hi, high)
    asia_lo  := na(asia_lo) or not was_asia ? low : math.min(asia_lo, low)
    was_asia := true
else if was_asia
    was_asia := false

if in_london
    london_hi  := na(london_hi) or not was_london ? high : math.max(london_hi, high)
    london_lo  := na(london_lo) or not was_london ? low : math.min(london_lo, low)
    was_london := true
else if was_london
    was_london := false

if in_ny
    ny_hi  := na(ny_hi) or not was_ny ? high : math.max(ny_hi, high)
    ny_lo  := na(ny_lo) or not was_ny ? low : math.min(ny_lo, low)
    was_ny := true
else if was_ny
    was_ny := false

var line  pdh_line = na
var line  pdl_line = na
var label pdh_lbl  = na
var label pdl_lbl  = na

if show_pdh_pdl and not na(pdh) and barstate.islast
    line.delete(pdh_line)
    line.delete(pdl_line)
    label.delete(pdh_lbl)
    label.delete(pdl_lbl)
    pdh_line := line.new(bar_index - 50, pdh, bar_index + 20, pdh, color=color.new(bear_col, 20), width=1, style=line.style_dotted, extend=extend.right)
    pdl_line := line.new(bar_index - 50, pdl, bar_index + 20, pdl, color=color.new(bull_col, 20), width=1, style=line.style_dotted, extend=extend.right)
    pdh_lbl  := label.new(bar_index + 20, pdh, "PDH", style=label.style_label_left, color=color(na), textcolor=color.new(bear_col, 0), size=size.tiny)
    pdl_lbl  := label.new(bar_index + 20, pdl, "PDL", style=label.style_label_left, color=color(na), textcolor=color.new(bull_col, 0), size=size.tiny)

pdh_sweep = not na(pdh) and high > pdh * (1 + sess_liq_pct / 100) and close < pdh
pdl_sweep = not na(pdl) and low  < pdl * (1 - sess_liq_pct / 100) and close > pdl
near_pdh  = not na(pdh) and math.abs(close - pdh) / close * 100 <= sess_liq_pct
near_pdl  = not na(pdl) and math.abs(close - pdl) / close * 100 <= sess_liq_pct
near_sess_hi = (not na(asia_hi) and math.abs(close - asia_hi) / close * 100 <= sess_liq_pct) or (not na(london_hi) and math.abs(close - london_hi) / close * 100 <= sess_liq_pct)
near_sess_lo = (not na(asia_lo) and math.abs(close - asia_lo) / close * 100 <= sess_liq_pct) or (not na(london_lo) and math.abs(close - london_lo) / close * 100 <= sess_liq_pct)

sess_level_bull = near_pdl or near_sess_lo or pdl_sweep
sess_level_bear = near_pdh or near_sess_hi or pdh_sweep

// ════════════════════════════════════════════════════════════════════════════
// ░░  VOLUME PROFILE (Calculated on Confirmed Bars)
// ════════════════════════════════════════════════════════════════════════════
vp_high = ta.highest(high, vp_bars)
vp_low  = ta.lowest(low,   vp_bars)
var float poc         = na
var float vah         = na
var float vp_val_calc = na

if barstate.isconfirmed and bar_index >= vp_bars
    float _max_vol       = 0.0
    float _max_vol_price = close
    float _ws            = 0.0
    float _wv            = 0.0
    float _ws2           = 0.0
    for i = 0 to vp_bars - 1
        float tp = (high[i] + low[i] + close[i]) / 3.0
        if volume[i] > _max_vol
            _max_vol       := volume[i]
            _max_vol_price := tp
        _ws  += tp * volume[i]
        _wv  += volume[i]
        _ws2 += tp * tp * volume[i]
    poc := _max_vol_price
    float _wm   = _wv > 0 ? _ws / _wv : close
    float _vr   = _wv > 0 ? _ws2 / _wv - _wm * _wm : 0.0
    float _sg   = _vr > 0 ? math.sqrt(_vr) : atr14
    vah         := _wm + _sg
    vp_val_calc := _wm - _sg

near_poc     = not na(poc) and math.abs(close - poc) / close * 100 <= poc_zone_pct
near_vah     = not na(vah) and math.abs(close - vah) / close * 100 <= poc_zone_pct
near_val     = not na(vp_val_calc) and math.abs(close - vp_val_calc) / close * 100 <= poc_zone_pct
vp_bull_conf = near_poc or near_val
vp_bear_conf = near_poc or near_vah

var line  poc_line    = na
var line  vah_line    = na
var line  vp_val_line = na
var label poc_lbl     = na
var label vah_lbl     = na
var label val_lbl     = na

if show_vp and not na(poc) and barstate.islast
    line.delete(poc_line)
    line.delete(vah_line)
    line.delete(vp_val_line)
    label.delete(poc_lbl)
    label.delete(vah_lbl)
    label.delete(val_lbl)
    poc_line    := line.new(bar_index - vp_bars, poc,         bar_index, poc,         color=color.new(color.yellow, 20), width=2, style=line.style_solid)
    vah_line    := line.new(bar_index - vp_bars, vah,         bar_index, vah,         color=color.new(bear_col, 40),     width=1, style=line.style_dashed)
    vp_val_line := line.new(bar_index - vp_bars, vp_val_calc, bar_index, vp_val_calc, color=color.new(bull_col, 40),     width=1, style=line.style_dashed)
    poc_lbl     := label.new(bar_index, poc,         "POC", style=label.style_label_left, color=color(na), textcolor=color.new(color.yellow, 0), size=size.tiny)
    vah_lbl     := label.new(bar_index, vah,         "VAH", style=label.style_label_left, color=color(na), textcolor=color.new(bear_col, 20),   size=size.tiny)
    val_lbl     := label.new(bar_index, vp_val_calc, "VAL", style=label.style_label_left, color=color(na), textcolor=color.new(bull_col, 20),   size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
// ░░  THE 3 CANONICAL SETUP ENGINES & TRIGGER VALIDATION
// ════════════════════════════════════════════════════════════════════════════

// Retest verification of demand/supply zone or broken level
retest_bull = armed_long and (in_bull_ob or in_bull_fvg or (not na(armed_long_trigger_lvl) and low <= armed_long_trigger_lvl + atr14 * 0.35 and close >= armed_long_trigger_lvl - atr14 * 0.25))
retest_bear = armed_short and (in_bear_ob or in_bear_fvg or (not na(armed_short_trigger_lvl) and high >= armed_short_trigger_lvl - atr14 * 0.35 and close <= armed_short_trigger_lvl + atr14 * 0.25))

// Setup A: Pullback SSL/BSL Sweep (Trend Continuation)
setup_a_long  = (htf_bias == 1 and h1_bias == 1) and in_discount and recent_ssl_sweep and (in_bull_ob or in_bull_fvg or retest_bull)
setup_a_short = (htf_bias == -1 and h1_bias == -1) and in_premium and recent_bsl_sweep and (in_bear_ob or in_bear_fvg or retest_bear)

// Setup B: Breakout + Retest Setup
setup_b_long  = (htf_bias == 1 and h1_bias == 1) and m15_breakout_long and armed_long and retest_bull
setup_b_short = (htf_bias == -1 and h1_bias == -1) and m15_breakout_short and armed_short and retest_bear

// Setup C: Liquidity Sweep Reversal (Countertrend / Supply-Demand Turn)
setup_c_short = in_premium and (liq_sweep_bear or recent_bsl_sweep) and (structure_bias == -1 or choch_bear) and is_disp_bear
setup_c_long  = in_discount and (liq_sweep_bull or recent_ssl_sweep) and (structure_bias == 1 or choch_bull) and is_disp_bull

// Trigger Logic
trigger_long  = (setup_a_long and retest_bull) or (setup_b_long and retest_bull) or (setup_c_long and is_disp_bull)
trigger_short = (setup_a_short and retest_bear) or (setup_b_short and retest_bear) or (setup_c_short and is_disp_bear)

string setup_name_long  = setup_a_long ? "Pullback SSL Sweep" : setup_b_long ? "Breakout Retest" : setup_c_long ? "Liquidity Reversal" : "Standard Retest"
string setup_name_short = setup_a_short ? "Pullback BSL Sweep" : setup_b_short ? "Breakdown Retest" : setup_c_short ? "Liquidity Reversal" : "Standard Retest"

// ════════════════════════════════════════════════════════════════════════════
// ░░  DYNAMIC RISK / REWARD & TRADE LEVELS
// ════════════════════════════════════════════════════════════════════════════
var float entry_p = na
var float sl_p    = na
var float tp1_p   = na
var float tp2_p   = na
var float tp3_p   = na
var float rr_val  = 0.0

if trigger_long
    entry_p := close
    float raw_sl = math.min(nz(bull_ob_lo, low), nz(last_pl, low), low)
    sl_p    := raw_sl - atr14 * 0.35
    float risk = math.max(entry_p - sl_p, atr14 * 0.5)
    tp1_p   := entry_p + risk * 1.0
    tp2_p   := entry_p + risk * 2.0
    tp3_p   := math.max(entry_p + risk * 3.0, nz(bsl_level, entry_p + risk * 3.0))
    rr_val  := (tp2_p - entry_p) / risk

if trigger_short
    entry_p := close
    float raw_sl = math.max(nz(bear_ob_hi, high), nz(last_ph, high), high)
    sl_p    := raw_sl + atr14 * 0.35
    float risk = math.max(sl_p - entry_p, atr14 * 0.5)
    tp1_p   := entry_p - risk * 1.0
    tp2_p   := entry_p - risk * 2.0
    tp3_p   := math.min(entry_p - risk * 3.0, nz(ssl_level, entry_p - risk * 3.0))
    rr_val  := (entry_p - tp2_p) / risk

// ════════════════════════════════════════════════════════════════════════════
// ░░  100-POINT CONFLUENCE SCORING ENGINE
// ════════════════════════════════════════════════════════════════════════════

// Long Factors (Max 100)
ls_4h     = (htf_bias == 1) ? 15 : 0
ls_1h     = (h1_bias == 1) ? 15 : 0
ls_pd     = in_discount ? 10 : 0
ls_ob_fvg = (in_bull_ob or in_bull_fvg) ? 10 : 0
ls_sweep  = recent_ssl_sweep ? 15 : 0
ls_15m    = (m15_close > prior_m15_open or m15_breakout_long) ? 10 : 0
ls_disp   = is_disp_bull ? 10 : 0
ls_retest = (retest_bull or tl_bear_retest or vp_bull_conf or sess_level_bull) ? 5 : 0
ls_vol    = (volume > vol_sma * 1.25) ? 5 : 0
ls_rr     = (rr_val >= 2.0) ? 5 : 0

long_score = ls_4h + ls_1h + ls_pd + ls_ob_fvg + ls_sweep + ls_15m + ls_disp + ls_retest + ls_vol + ls_rr

// Short Factors (Max 100)
ss_4h     = (htf_bias == -1) ? 15 : 0
ss_1h     = (h1_bias == -1) ? 15 : 0
ss_pd     = in_premium ? 10 : 0
ss_ob_fvg = (in_bear_ob or in_bear_fvg) ? 10 : 0
ss_sweep  = recent_bsl_sweep ? 15 : 0
ss_15m    = (m15_close < prior_m15_open or m15_breakout_short) ? 10 : 0
ss_disp   = is_disp_bear ? 10 : 0
ss_retest = (retest_bear or tl_bull_retest or vp_bear_conf or sess_level_bear) ? 5 : 0
ss_vol    = (volume > vol_sma * 1.25) ? 5 : 0
ss_rr     = (rr_val >= 2.0) ? 5 : 0

short_score = ss_4h + ss_1h + ss_pd + ss_ob_fvg + ss_sweep + ss_15m + ss_disp + ss_retest + ss_vol + ss_rr

// ════════════════════════════════════════════════════════════════════════════
// ░░  HARD GATES & DETERMINISTIC DECISION
// ════════════════════════════════════════════════════════════════════════════
long_hard_gate  = trigger_long and (rr_val >= min_rr) and (long_score >= min_score)
short_hard_gate = trigger_short and (rr_val >= min_rr) and (short_score >= min_score)

var int last_sig_bar = -999
cooldown_ok = (bar_index - last_sig_bar) >= sig_cooldown

final_long_signal  = long_hard_gate and not long_hard_gate[1] and cooldown_ok
final_short_signal = short_hard_gate and not short_hard_gate[1] and cooldown_ok

if final_long_signal or final_short_signal
    last_sig_bar := bar_index

string quality_grade = ""
if long_hard_gate
    quality_grade := long_score >= 90 ? "A+" : long_score >= 80 ? "A" : "B"
else if short_hard_gate
    quality_grade := short_score >= 90 ? "A+" : short_score >= 80 ? "A" : "B"

// ════════════════════════════════════════════════════════════════════════════
// ░░  PLOTS & VISUAL TRADE LABELS
// ════════════════════════════════════════════════════════════════════════════
[st_val, st_dir] = ta.supertrend(3.0, 10)
plot(show_st and st_dir < 0 ? st_val : na, "ST Bull", color=color.new(bull_col, 50), linewidth=1, style=plot.style_linebr)
plot(show_st and st_dir > 0 ? st_val : na, "ST Bear", color=color.new(bear_col, 50), linewidth=1, style=plot.style_linebr)

plot(long_score,  "CE Long Score",  display=display.none)
plot(short_score, "CE Short Score", display=display.none)

if show_signals and final_long_signal
    _lbl_txt = "🟢 LONG [" + quality_grade + "]\n" +
               "Setup: " + setup_name_long + "\n" +
               "Entry: " + str.tostring(entry_p, "#.##") + "\n" +
               "SL:    " + str.tostring(sl_p, "#.##") + "\n" +
               "TP1:   " + str.tostring(tp1_p, "#.##") + " (1R)\n" +
               "TP2:   " + str.tostring(tp2_p, "#.##") + " (2R)\n" +
               "TP3:   " + str.tostring(tp3_p, "#.##") + "\n" +
               (show_score ? "Score: " + str.tostring(long_score) + "/100" : "")
    label.new(bar_index, low - atr14 * 1.5, _lbl_txt,
         style=label.style_label_up, color=color.new(#00c87a, 10), textcolor=color.white, size=size.small)

if show_signals and final_short_signal
    _lbl_txt = "🔴 SHORT [" + quality_grade + "]\n" +
               "Setup: " + setup_name_short + "\n" +
               "Entry: " + str.tostring(entry_p, "#.##") + "\n" +
               "SL:    " + str.tostring(sl_p, "#.##") + "\n" +
               "TP1:   " + str.tostring(tp1_p, "#.##") + " (1R)\n" +
               "TP2:   " + str.tostring(tp2_p, "#.##") + " (2R)\n" +
               "TP3:   " + str.tostring(tp3_p, "#.##") + "\n" +
               (show_score ? "Score: " + str.tostring(short_score) + "/100" : "")
    label.new(bar_index, high + atr14 * 1.5, _lbl_txt,
         style=label.style_label_down, color=color.new(#ff3d3d, 10), textcolor=color.white, size=size.small)

// Background Bias Tint
bgcolor(htf_bias ==  1 and h1_bias ==  1 ? color.new(bull_col, 95) :
        htf_bias == -1 and h1_bias == -1 ? color.new(bear_col, 95) :
        htf_bias ==  1                   ? color.new(bull_col, 98) :
        htf_bias == -1                   ? color.new(bear_col, 98) : na,
        title="4H+1H MTF Bias BG")

barcolor(structure_bias ==  1 ? color.new(bull_col, 65) :
         structure_bias == -1 ? color.new(bear_col, 65) : na)

// ════════════════════════════════════════════════════════════════════════════
// ░░  LIVE SMC-CE v7 DASHBOARD TABLE
// ════════════════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 3, 19,
     bgcolor=color.new(#0a0a0f, 5),
     border_color=color.new(#242436, 30), border_width=1,
     frame_color=color.new(#383854, 20), frame_width=1)

if show_dash and barstate.islast
    pos = color.new(#00c87a, 20)
    neg = color.new(#ff3d3d, 20)
    neu = color.new(#242436, 40)
    hd  = color.new(#121224, 10)
    blk = color.new(#ff0000, 10)
    wht = color.white

    table.cell(dash, 0, 0, "SMC-CE v7.0 [EXEC]", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 0, "BULL", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 0, "BEAR", bgcolor=hd, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 1, "🟥 4H MACRO", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 1, "", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 1, "", bgcolor=hd, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 2, "  4H Bias", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 2, htf_bias == 1 ? "BULL ✓" : "—", bgcolor=htf_bias == 1 ? pos : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 2, htf_bias == -1 ? "BEAR ✓" : "—", bgcolor=htf_bias == -1 ? neg : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 3, "  P/D Location", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 3, in_discount ? "Discount ✓" : "Premium ⚠", bgcolor=in_discount ? pos : color.new(color.orange, 40), text_color=wht, text_size=size.small)
    table.cell(dash, 2, 3, in_premium ? "Premium ✓" : "Discount ⚠", bgcolor=in_premium ? neg : color.new(color.orange, 40), text_color=wht, text_size=size.small)

    table.cell(dash, 0, 4, "🟧 1H DIRECTION", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 4, "", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 4, "", bgcolor=hd, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 5, "  1H Structure", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 5, h1_bias == 1 ? "BULL ✓" : "—", bgcolor=h1_bias == 1 ? pos : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 5, h1_bias == -1 ? "BEAR ✓" : "—", bgcolor=h1_bias == -1 ? neg : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 6, "🟨 15m CONTEXT", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 6, "", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 6, "", bgcolor=hd, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 7, "  15m Sweep/BO", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 7, m15_ssl_sweep ? "SSL SWEPT" : m15_breakout_long ? "BREAKOUT" : "—", bgcolor=m15_ssl_sweep or m15_breakout_long ? pos : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 7, m15_bsl_sweep ? "BSL SWEPT" : m15_breakout_short ? "BREAKDOWN" : "—", bgcolor=m15_bsl_sweep or m15_breakout_short ? neg : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 8, "🟩 5m TRIGGER", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 8, "", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 8, "", bgcolor=hd, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 9, "  Armed CHoCH", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 9, armed_long ? "ARMED ✓" : "WAIT", bgcolor=armed_long ? pos : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 9, armed_short ? "ARMED ✓" : "WAIT", bgcolor=armed_short ? neg : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 10, "  OB/FVG Retest", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 10, retest_bull ? "TESTED ✓" : "WAIT", bgcolor=retest_bull ? pos : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 10, retest_bear ? "TESTED ✓" : "WAIT", bgcolor=retest_bear ? neg : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 11, "  Displacement", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 11, is_disp_bull ? "STRONG ✓" : "—", bgcolor=is_disp_bull ? pos : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 11, is_disp_bear ? "STRONG ✓" : "—", bgcolor=is_disp_bear ? neg : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 12, "⭐ Confluence", bgcolor=hd, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(long_score) + "/100", bgcolor=long_score >= 80 ? pos : long_score >= 70 ? color.new(color.orange, 30) : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 12, str.tostring(short_score) + "/100", bgcolor=short_score >= 80 ? neg : short_score >= 70 ? color.new(color.orange, 30) : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 13, "🎯 Setup Type", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 13, trigger_long ? setup_name_long : "—", bgcolor=trigger_long ? pos : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 13, trigger_short ? setup_name_short : "—", bgcolor=trigger_short ? neg : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 14, "⚖ R:R (TP2)", bgcolor=neu, text_color=wht, text_size=size.small)
    table.cell(dash, 1, 14, trigger_long ? str.tostring(rr_val, "#.#") + "R" : "—", bgcolor=trigger_long and rr_val >= 2.0 ? pos : neu, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 14, trigger_short ? str.tostring(rr_val, "#.#") + "R" : "—", bgcolor=trigger_short and rr_val >= 2.0 ? neg : neu, text_color=wht, text_size=size.small)

    table.cell(dash, 0, 15, "🚀 DECISION", bgcolor=hd, text_color=wht, text_size=size.small)
    string final_dec = final_long_signal or (long_hard_gate and cooldown_ok) ? "🟢 LONG" :
                       final_short_signal or (short_hard_gate and cooldown_ok) ? "🔴 SHORT" :
                       "⚪ NO TRADE"
    color dec_col    = final_long_signal or (long_hard_gate and cooldown_ok) ? pos :
                       final_short_signal or (short_hard_gate and cooldown_ok) ? neg : neu

    table.cell(dash, 1, 15, final_dec, bgcolor=dec_col, text_color=wht, text_size=size.small)
    table.cell(dash, 2, 15, quality_grade != "" ? "[" + quality_grade + "]" : "AVOID", bgcolor=dec_col, text_color=wht, text_size=size.small)

// ════════════════════════════════════════════════════════════════════════════
// ░░  STRUCTURED MACHINE-READABLE ALERTS
// ════════════════════════════════════════════════════════════════════════════
if final_long_signal
    string json_payload = '{"symbol":"' + syminfo.ticker + '","strategy":"SMC_CE_V7","decision":"LONG","setup":"' + setup_name_long + '","score":' + str.tostring(long_score) + ',"grade":"' + quality_grade + '","entry":' + str.tostring(entry_p, "#.##") + ',"sl":' + str.tostring(sl_p, "#.##") + ',"tp1":' + str.tostring(tp1_p, "#.##") + ',"tp2":' + str.tostring(tp2_p, "#.##") + ',"tp3":' + str.tostring(tp3_p, "#.##") + ',"rr":' + str.tostring(rr_val, "#.##") + '}'
    alert(json_payload, alert.freq_once_per_bar)

if final_short_signal
    string json_payload = '{"symbol":"' + syminfo.ticker + '","strategy":"SMC_CE_V7","decision":"SHORT","setup":"' + setup_name_short + '","score":' + str.tostring(short_score) + ',"grade":"' + quality_grade + '","entry":' + str.tostring(entry_p, "#.##") + ',"sl":' + str.tostring(sl_p, "#.##") + ',"tp1":' + str.tostring(tp1_p, "#.##") + ',"tp2":' + str.tostring(tp2_p, "#.##") + ',"tp3":' + str.tostring(tp3_p, "#.##") + ',"rr":' + str.tostring(rr_val, "#.##") + '}'
    alert(json_payload, alert.freq_once_per_bar)

alertcondition(final_long_signal, "SMC-CE v7 LONG [Deterministic]", "SMC-CE v7 LONG Triggered | {{ticker}} {{interval}} | Close {{close}}")
alertcondition(final_short_signal, "SMC-CE v7 SHORT [Deterministic]", "SMC-CE v7 SHORT Triggered | {{ticker}} {{interval}} | Close {{close}}")
alertcondition(final_long_signal and long_score >= 85, "SMC-CE v7 A+ LONG [High Conviction]", "SMC-CE v7 A+ High Conviction LONG | {{ticker}} {{interval}} | Close {{close}}")
alertcondition(final_short_signal and short_score >= 85, "SMC-CE v7 A+ SHORT [High Conviction]", "SMC-CE v7 A+ High Conviction SHORT | {{ticker}} {{interval}} | Close {{close}}")

{
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "moduleResolution": "node16",
    "module": "node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "out",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "types/**/*",
    "webpack.config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}